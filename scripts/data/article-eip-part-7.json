    {
      "_key": "b-06-h2-patterns",
      "_type": "block",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-h2-patterns-s0",
          "_type": "span",
          "text": "2. Pattern Catalog & Formal Realizations",
          "marks": []
        }
      ]
    },
    {
      "_key": "b-06-p-patterns-intro",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-p-patterns-intro-s0",
          "_type": "span",
          "text": "In this installment, we formalize the following core integration patterns established by Gregor Hohpe and Bobby Woolf, mapping each to its modern cloud-native realization:",
          "marks": []
        }
      ]
    },
    {
      "_key": "b-06-pat-00",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-00-s0",
          "_type": "span",
          "text": "Control Bus: Dedicated administrative communication channel for monitoring, configuring, and orchestrating distributed integration components.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-pat-01",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-01-s0",
          "_type": "span",
          "text": "Detour & Wire Tap: Non-intrusive message interception: copies live message traffic to secondary channels for audit, logging, or metric aggregation without altering data flow.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-pat-02",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-02-s0",
          "_type": "span",
          "text": "Message History: Appends processing component timestamps and instance identifiers to the message header as it traverses pipeline stages.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-pat-03",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-03-s0",
          "_type": "span",
          "text": "Message Store: Centralized durable archival repository recording complete message payloads for audit compliance, dispute resolution, and state replay.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-pat-04",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-04-s0",
          "_type": "span",
          "text": "Smart Proxy: Transparent mediation proxy intercepting requests to inject correlation tokens, rate limiting, and distributed tracing headers.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-pat-05",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-05-s0",
          "_type": "span",
          "text": "Test Message: Synthetic heartbeat probes injected into live integration highways to verify routing correctness and end-to-end latency.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-pat-06",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-06-s0",
          "_type": "span",
          "text": "Channel Purger: Administrative utility for safely draining, filtering, and resetting dead-letter and test queues without broker restarts.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-pat-07",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-pat-07-s0",
          "_type": "span",
          "text": "OpenTelemetry Context Propagation: Injecting and extracting W3C traceparent and tracestate headers across message broker boundaries to preserve distributed causal traces.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-h2-invariants",
      "_type": "block",
      "style": "h2",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-h2-invariants-s0",
          "_type": "span",
          "text": "3. Invariants, Failure Modes & Physical Constraints",
          "marks": []
        }
      ]
    },
    {
      "_key": "b-06-p-invariants-intro",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-p-invariants-intro-s0",
          "_type": "span",
          "text": "Engineering resilient enterprise integration topologies requires analyzing the exact failure boundaries and physical constraints governing these patterns:",
          "marks": []
        }
      ]
    },
    {
      "_key": "b-06-inv-00",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-inv-00-s0",
          "_type": "span",
          "text": "The Asynchronous Observability Deficit: When messages decouple senders from receivers, traditional synchronous thread-local stack traces vanish; W3C correlation propagation is mandatory for distributed root cause analysis.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-inv-01",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-inv-01-s0",
          "_type": "span",
          "text": "Wire Tap Performance Overhead: Secondary logging and tapping must execute asynchronously or over non-blocking buffers to prevent diagnostic inspection from degrading primary pipeline throughput.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    },
    {
      "_key": "b-06-inv-02",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "b-06-inv-02-s0",
          "_type": "span",
          "text": "Control Plane Isolation: Administrative control commands must run on isolated physical or virtual channels to prevent operator commands from competing with production message queues.",
          "marks": []
        }
      ],
      "listItem": "bullet",
      "level": 1
    }
  ]
}