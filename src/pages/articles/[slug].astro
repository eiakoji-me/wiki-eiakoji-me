---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RightRail from '../../components/RightRail.astro';
import RichText from '../../components/RichText.astro';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { fetchContent, formatDate } from '../../lib/content';
import { imageUrl } from '../../lib/sanity/image';
import { articleBySlugQuery, articleSlugsQuery, topicsListQuery } from '../../lib/sanity/queries';
import type { Article, Topic } from '../../lib/sanity/types';
import { extractHeadings } from '../../lib/slugify';
import { buildTopicTree, getTopicBreadcrumbs, topicHref } from '../../lib/topics';

export const getStaticPaths: GetStaticPaths = async () => {
  const slugs = await fetchContent<string[]>(articleSlugsQuery);
  return slugs.map((slug) => ({ params: { slug } }));
};

const { slug } = Astro.params;
const [article, allTopics] = await Promise.all([
  fetchContent<Article>(articleBySlugQuery, { slug: slug! }),
  fetchContent<Topic[]>(topicsListQuery),
]);

const socialImage = article.seo?.image?.asset
  ? imageUrl(article.seo.image.asset, 1200)
  : article.featuredImage?.asset
    ? imageUrl(article.featuredImage.asset, 1200)
    : undefined;

const headings = extractHeadings(article.body);

const formatLabels: Record<string, string> = {
  article: 'Deep Dive',
  'deep-dive': 'Deep Dive',
  tutorial: 'Tutorial',
  workshop: 'Workshop',
  'case-study': 'Case Study',
  showcase: 'Showcase',
  'reading-note': 'Reading Note',
  'reading-notes': 'Reading Note',
  reference: 'Reference',
};
const activeFormat = article.format || article.kind || 'article';
const formatLabel = formatLabels[activeFormat] || 'Article';

const tree = buildTopicTree(allTopics);
let breadcrumbs = [{ label: 'Articles', href: '/articles/' }, { label: article.title }];

if (article.primaryTopic?.slug) {
  const topicCrumbs = getTopicBreadcrumbs(article.primaryTopic.slug, tree);
  breadcrumbs = [...topicCrumbs, { label: article.title }];
}
---

<WikiLayout
  title={article.seo?.title ?? article.title}
  description={article.seo?.description ?? article.summary}
  image={socialImage}
  currentSlug={article.primaryTopic?.slug ?? 'articles'}
>
  <article class="wiki-article">
    <Breadcrumbs items={breadcrumbs} />

    <header class="entry-header">
      <div class="entry-meta">
        <span class="badge">{formatLabel}</span>
        {article.difficulty && <span class="badge-neutral">{article.difficulty}</span>}
        <time datetime={article.publishedAt}>{formatDate(article.publishedAt!)}</time>
        {article.series && (
          <a href={`/series/${article.series.slug}/`} class="badge">
            Part of {article.series.title}
          </a>
        )}
      </div>

      <h1>{article.title}</h1>
      <p class="entry-summary">{article.summary}</p>

      {article.primaryTopic && (
        <div class="entry-taxonomy">
          <span class="tax-label">Topic:</span>
          {topicHref(tree, article.primaryTopic.slug) ? (
            <a href={topicHref(tree, article.primaryTopic.slug)} class="primary-topic-link">
              {article.primaryTopic.title}
            </a>
          ) : (
            <span class="primary-topic-text">{article.primaryTopic.title}</span>
          )}
          {article.relatedTopics && article.relatedTopics.length > 0 && (
            <>
              <span class="tax-separator">·</span>
              <span class="tax-label">Related:</span>
              {article.relatedTopics.map((rel) =>
                topicHref(tree, rel.slug) ? (
                  <a href={topicHref(tree, rel.slug)} class="related-topic-link">
                    {rel.title}
                  </a>
                ) : (
                  <span class="related-topic-text">{rel.title}</span>
                )
              )}
            </>
          )}
        </div>
      )}

      {(article.repositoryUrl || article.demoUrl || (article.technologies && article.technologies.length > 0)) && (
        <div class="workshop-callout">
          <div class="workshop-links">
            {article.repositoryUrl && (
              <a href={article.repositoryUrl} target="_blank" rel="noopener noreferrer" class="button secondary">
                GitHub Repository ↗
              </a>
            )}
            {article.demoUrl && (
              <a href={article.demoUrl} target="_blank" rel="noopener noreferrer" class="button primary">
                Live Showcase ↗
              </a>
            )}
          </div>
          {article.technologies && article.technologies.length > 0 && (
            <ul class="tech-tags">
              {article.technologies.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          )}
        </div>
      )}

      {article.bookAuthor && (
        <div class="book-callout">
          <p>
            <strong>Author:</strong> {article.bookAuthor}
            {article.referenceUrl && (
              <span> · <a href={article.referenceUrl} target="_blank" rel="noopener noreferrer">Source Reference ↗</a></span>
            )}
          </p>
        </div>
      )}

      {article.topics && article.topics.length > 0 && (
        <ul class="tags">
          {article.topics.map((topic) => (
            <li>{topic}</li>
          ))}
        </ul>
      )}
    </header>

    {article.featuredImage?.asset && (
      <figure class="entry-image">
        <img
          src={imageUrl(article.featuredImage.asset, 1600)}
          alt={article.featuredImage.alt}
          width="1600"
          height="900"
        />
        {article.featuredImage.caption && <figcaption>{article.featuredImage.caption}</figcaption>}
      </figure>
    )}

    <div class="entry-body">
      <RichText value={article.body} />
    </div>

    {article.series?.articles && article.series.articles.length > 1 && (
      <nav class="series-pager" aria-label="Series navigation">
        <div class="pager-title">Continue reading: {article.series.title}</div>
        <div class="pager-grid">
          {(() => {
            const idx = article.series!.articles!.findIndex((a) => a.slug === article.slug);
            const prev = idx > 0 ? article.series!.articles![idx - 1] : null;
            const next = idx >= 0 && idx < article.series!.articles!.length - 1 ? article.series!.articles![idx + 1] : null;
            return (
              <>
                {prev ? (
                  <a href={`/articles/${prev.slug}/`} class="pager-item prev">
                    <span class="dir">← Previous article</span>
                    <span class="label">{prev.title}</span>
                  </a>
                ) : <div />}
                {next ? (
                  <a href={`/articles/${next.slug}/`} class="pager-item next">
                    <span class="dir">Next article →</span>
                    <span class="label">{next.title}</span>
                  </a>
                ) : <div />}
              </>
            );
          })()}
        </div>
      </nav>
    )}
  </article>

  <RightRail headings={headings} article={article} topicTree={tree} slot="right-rail" />
</WikiLayout>

<style>
  .wiki-article {
    width: 100%;
    max-width: 820px;
  }
  .entry-taxonomy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-size: var(--text-nav);
  }
  .tax-label {
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .primary-topic-link {
    font-weight: 500;
    color: var(--link);
    text-decoration: none;
  }
  .related-topic-link {
    color: var(--link);
    text-decoration: none;
  }
  /* Topics without a hub page are named but not linked. */
  .primary-topic-text {
    font-weight: 500;
    color: var(--text);
  }
  .related-topic-text {
    color: var(--text);
  }
  .primary-topic-link:hover, .related-topic-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
  .tax-separator {
    color: var(--border-strong);
  }
  .workshop-callout {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    margin-top: 24px;
    background: var(--background);
    border: 1px solid var(--border);
    border-left: 3px solid var(--selected-indicator);
    border-radius: 4px;
  }
  .workshop-links {
    display: flex;
    gap: 10px;
  }
  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tech-tags li {
    font-size: var(--text-xs);
    padding: 2px 6px;
    background: var(--badge-neutral-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--badge-neutral-text);
  }
  .book-callout {
    padding: 12px 16px;
    margin-top: 20px;
    background: var(--background-subtle);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: var(--text-nav);
  }
  .book-callout p {
    margin: 0;
  }
  .series-pager {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .pager-title {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--text-muted);
    margin-bottom: 12px;
  }
  .pager-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .pager-item {
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 140ms ease;
  }
  .pager-item:hover {
    border-color: var(--border-strong);
  }
  .pager-item:hover .label {
    text-decoration: underline;
  }
  .pager-item.next {
    text-align: right;
  }
  .pager-item .dir {
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .pager-item .label {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--text);
  }
</style>
