---
import type { GetStaticPaths } from 'astro';
import ArticlePager from '../../components/ArticlePager.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RightRail from '../../components/RightRail.astro';
import RichText from '../../components/RichText.astro';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { fetchContent, formatDate } from '../../lib/content';
import { imageUrl } from '../../lib/sanity/image';
import { articleBySlugQuery, articleSlugsQuery, topicsListQuery } from '../../lib/sanity/queries';
import type { Article, Topic } from '../../lib/sanity/types';
import { extractHeadings } from '../../lib/slugify';
import { buildTopicTree, getTopicBreadcrumbs } from '../../lib/topics';

export const getStaticPaths: GetStaticPaths = async () => {
  const slugs = await fetchContent<string[]>(articleSlugsQuery);
  return slugs.map((slug) => ({ params: { slug } }));
};

const { slug } = Astro.params;
const [article, allTopics] = await Promise.all([
  fetchContent<Article>(articleBySlugQuery, { slug: slug! }),
  fetchContent<Topic[]>(topicsListQuery),
]);

const socialImage = article.seo?.image?.asset
  ? imageUrl(article.seo.image.asset, 1200)
  : article.featuredImage?.asset
    ? imageUrl(article.featuredImage.asset, 1200)
    : undefined;

const headings = extractHeadings(article.body);

const tree = buildTopicTree(allTopics);
let breadcrumbs = [{ label: 'Articles', href: '/articles/' }, { label: article.title }];

if (article.primaryTopic?.slug) {
  const topicCrumbs = getTopicBreadcrumbs(article.primaryTopic.slug, tree);
  breadcrumbs = [...topicCrumbs, { label: article.title }];
}
---

<WikiLayout
  title={article.seo?.title ?? article.title}
  description={article.seo?.description ?? article.summary}
  image={socialImage}
  currentSlug={article.primaryTopic?.slug}
  currentArticleSlug={article.slug}
>
  <article class="wiki-article">
    <Breadcrumbs items={breadcrumbs} />

    <header class="entry-header">
      <div class="entry-meta">
        {article.difficulty && <span class="badge-neutral">{article.difficulty}</span>}
        <time datetime={article.publishedAt}>{formatDate(article.publishedAt!)}</time>
      </div>

      <h1>{article.title}</h1>
      <p class="entry-summary">{article.summary}</p>

      {article.bookAuthor && (
        <div class="book-callout">
          <p>
            <strong>Author:</strong> {article.bookAuthor}
            {article.referenceUrl && (
              <span> · <a href={article.referenceUrl} target="_blank" rel="noopener noreferrer">Source Reference ↗</a></span>
            )}
          </p>
        </div>
      )}
    </header>

    {article.featuredImage?.asset && (
      <figure class="entry-image">
        <img
          src={imageUrl(article.featuredImage.asset, 1600)}
          alt={article.featuredImage.alt}
          width="1600"
          height="900"
        />
        {article.featuredImage.caption && <figcaption>{article.featuredImage.caption}</figcaption>}
      </figure>
    )}

    <div class="entry-body">
      <RichText value={article.body} />
      <ArticlePager body={article.body} />
    </div>
  </article>

  <RightRail headings={headings} article={article} topicTree={tree} slot="right-rail" />
</WikiLayout>

<style>
  .wiki-article {
    width: 100%;
    max-width: 820px;
  }
  .book-callout {
    padding: 12px 16px;
    margin-top: 20px;
    background: var(--background-subtle);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: var(--text-nav);
  }
  .book-callout p {
    margin: 0;
  }
</style>
