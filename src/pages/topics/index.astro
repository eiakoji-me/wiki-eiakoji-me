---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EmptyState from '../../components/EmptyState.astro';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { fetchContent } from '../../lib/content';
import { articlesQuery, topicsListQuery } from '../../lib/sanity/queries';
import type { ContentSummary, Topic } from '../../lib/sanity/types';
import { buildTopicTree, type TopicNode } from '../../lib/topics';

const [rawTopics, rawArticles] = await Promise.all([
  fetchContent<Topic[]>(topicsListQuery).catch(() => []),
  fetchContent<ContentSummary[]>(articlesQuery).catch(() => []),
]);

const topics: Topic[] = rawTopics ?? [];
const articles: ContentSummary[] = rawArticles ?? [];

const tree = buildTopicTree(topics, articles);
const rootTopics = tree.rootTopics;
---

<WikiLayout title="Topics" description="Topics on wiki.eiakoji.me: system design, software architecture, and platform engineering." currentSlug="topics">
  <div class="topic-index-page">
    <Breadcrumbs items={[{ label: 'Topics' }]} />
    <header class="page-heading">
      <h1>Topics</h1>
      <p>Structured technical knowledge base across systems architecture, programming languages, cloud platforms, and engineering craft.</p>
    </header>

    <section class="section" aria-label="Topic catalog">
      {rootTopics.length > 0 ? (
        <div class="domains-container">
          {rootTopics.map((rootNode: TopicNode) => (
            <div class="domain-group">
              <div class="domain-header">
                <div>
                  <h2 class="domain-title">
                    <a href={`/topics/${rootNode.topic.slug}/`}>{rootNode.topic.title}</a>
                  </h2>
                  <p class="domain-summary">{rootNode.topic.summary}</p>
                </div>
              </div>

              {rootNode.children.length > 0 && (
                <ul class="domain-topics">
                  {rootNode.children.map((childNode: TopicNode) => (
                    <li>
                      <a href={`/topics/${childNode.topic.slug}/`}>{childNode.topic.title}</a>
                      {childNode.topic.summary && <p>{childNode.topic.summary}</p>}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      ) : (
        <EmptyState title="No published topics yet" message="Topics will appear here as they are published." />
      )}
    </section>
  </div>
</WikiLayout>

<style>
  .domains-container {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .domain-group {
    border-top: 2px solid var(--border-strong);
    padding-top: 20px;
  }
  .domain-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    margin-bottom: 20px;
  }
  .domain-title {
    margin: 0 0 6px;
    font-size: var(--title-section);
  }
  .domain-title a {
    text-decoration: none;
    color: var(--text-strong);
  }
  .domain-title a:hover {
    text-decoration: underline;
  }
  .domain-summary {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-base);
    max-width: 70ch;
  }
  .domain-topics {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .domain-topics a {
    font-weight: 600;
    color: var(--link);
    text-decoration: none;
  }
  .domain-topics a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
  .domain-topics p {
    margin: 4px 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    max-width: 70ch;
  }
</style>
