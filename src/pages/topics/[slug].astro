---
import type { GetStaticPaths } from 'astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContentCard from '../../components/ContentCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import RichText from '../../components/RichText.astro';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { fetchContent } from '../../lib/content';
import { articlesQuery, topicBySlugQuery, topicsListQuery } from '../../lib/sanity/queries';
import type { Topic, ContentSummary } from '../../lib/sanity/types';
import { buildTopicTree, getTopicBreadcrumbs } from '../../lib/topics';

interface TopicDetail extends Topic {
  subtopics?: Array<{ _id: string; title: string; slug: string; summary?: string; icon?: string }>;
  articles?: ContentSummary[];
}

// Only topics that sit in the domain tree get a hub page.
export const getStaticPaths: GetStaticPaths = async () => {
  const topics = await fetchContent<Topic[]>(topicsListQuery).catch(() => []);
  const tree = buildTopicTree(topics ?? []);
  return Array.from(tree.slugMap.keys()).map((slug) => ({ params: { slug } }));
};

const { slug } = Astro.params;
const [fetchedTopic, rawTopics, rawArticles] = await Promise.all([
  fetchContent<TopicDetail>(topicBySlugQuery, { slug: slug! }).catch(() => null),
  fetchContent<Topic[]>(topicsListQuery).catch(() => []),
  fetchContent<ContentSummary[]>(articlesQuery).catch(() => []),
]);

const allTopics: Topic[] = rawTopics ?? [];
const allArticles: ContentSummary[] = rawArticles ?? [];

const tree = buildTopicTree(allTopics, allArticles);
const breadcrumbs = getTopicBreadcrumbs(slug!, tree);
const currentNode = tree.slugMap.get(slug!);
const topic: TopicDetail = fetchedTopic ?? currentNode!.topic;

// Align published entries with the topic and its descendant tree rollups
const topicArticles = allArticles.filter((article) =>
  currentNode?.rollupArticleIds.has(article._id)
);
---

<WikiLayout title={topic.title} description={topic.summary} currentSlug={topic.slug}>
  <div class="topic-hub-page">
    <Breadcrumbs items={breadcrumbs} />

    <header class="entry-header">
      <div class="entry-meta">
        <span class="badge">{topic.kind === 'domain' ? 'Domain' : 'Topic'}</span>
        {topic.parent && (
          <span>Part of <a href={`/topics/${topic.parent.slug}/`}>{topic.parent.title}</a></span>
        )}
        {currentNode && currentNode.rollupArticleCount > 0 && (
          <span>{currentNode.rollupArticleCount} {currentNode.rollupArticleCount === 1 ? 'total entry' : 'total entries'}</span>
        )}
      </div>
      <h1>{topic.title}</h1>
      <p class="entry-summary">{topic.summary}</p>
    </header>

    {topic.description && topic.description.length > 0 && (
      <section class="topic-overview section">
        <RichText value={topic.description} />
      </section>
    )}

    {currentNode && currentNode.children.length > 0 && (
      <section class="section subtopics-section" aria-label="Subtopics">
        <div class="section-header">
          <h2>Subtopics</h2>
        </div>
        <div class="subtopics-grid">
          {currentNode.children.map(({ topic: sub }) => (
            <a href={`/topics/${sub.slug}/`} class="subtopic-card">
              <h3>{sub.title}</h3>
              {sub.summary && <p>{sub.summary}</p>}
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section articles-section" aria-label="Entries under this topic">
      <div class="section-header">
        <h2>Published Entries</h2>
      </div>
      {topicArticles.length > 0 ? (
        <div class="card-grid">
          {topicArticles.map((item) => (
            <ContentCard item={item} />
          ))}
        </div>
      ) : (
        <EmptyState
          title="No published articles yet"
          message={`Articles on ${topic.title} will appear here as they are published.`}
        />
      )}
    </section>
  </div>
</WikiLayout>

<style>
  .subtopics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .subtopic-card {
    display: block;
    padding: 16px 20px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 140ms ease;
  }
  .subtopic-card:hover {
    border-color: var(--border-strong);
  }
  .subtopic-card:hover h3 {
    text-decoration: underline;
  }
  .subtopic-card h3 {
    margin: 0 0 6px;
    font-size: var(--text-base);
  }
  .subtopic-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
</style>
