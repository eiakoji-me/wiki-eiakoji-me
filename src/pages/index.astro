---
import ContentCard from '../components/ContentCard.astro';
import EmptyState from '../components/EmptyState.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { contentHref, formatDate } from '../lib/content';
import { fetchContent } from '../lib/content';
import { imageUrl } from '../lib/sanity/image';
import { homepageQuery } from '../lib/sanity/queries';
import type { ContentSummary } from '../lib/sanity/types';

interface HomepageData {
  featured: ContentSummary[];
  latest: ContentSummary[];
  workshops: ContentSummary[];
  systemDesignTopic?: {
    _id: string;
    title: string;
    slug: string;
    summary: string;
    archetypesTopic?: {
      _id: string;
      title: string;
      slug: string;
      summary: string;
    };
  };
  archetypesArticles: ContentSummary[];
  systemDesignArticles: ContentSummary[];
  platformTopic?: {
    _id: string;
    title: string;
    slug: string;
    summary: string;
  };
  architectureTopic?: {
    _id: string;
    title: string;
    slug: string;
    summary: string;
  };
}

const data = await fetchContent<HomepageData>(homepageQuery);

const featured = data.featured ?? [];
const leadFeature = featured[0];
const secondaryFeatures = featured.slice(1, 3);

const latest = data.latest ?? [];
const workshops = data.workshops ?? [];
const archetypesArticles = data.archetypesArticles ?? [];
const systemDesignArticles = data.systemDesignArticles ?? [];

// The section leads with the archetype framework, so broader system design articles
// only fill remaining slots once at least one archetypes article exists.
// Deduplicate articles so an article present in both archetypes and system design is never repeated
const seenSystemDesignIds = new Set<string>();
const systemDesignCombined = (archetypesArticles.length > 0 ? [...archetypesArticles, ...systemDesignArticles] : [])
  .filter((item) => {
    if (!item?._id || seenSystemDesignIds.has(item._id)) return false;
    seenSystemDesignIds.add(item._id);
    return true;
  })
  .slice(0, 4);
---

<BaseLayout>
  <!-- 1. FEATURED CONTENT HERO -->
  <section class="section shell featured-section" aria-labelledby="featured-heading">
    <div class="section-header">
      <h1 id="featured-heading" class="visually-hidden">wiki.eiakoji.me — Featured Technical Knowledge</h1>
      <p class="eyebrow">Featured Work</p>
    </div>

    {featured.length > 0 ? (
      <div class="featured-grid">
        <!-- Lead Feature -->
        <article class="lead-feature-card">
          <a class="lead-link" href={contentHref(leadFeature._type, leadFeature.slug)} aria-label={`Read ${leadFeature.title}`}>
            {leadFeature.featuredImage?.asset && (
              <img
                class="lead-image"
                src={imageUrl(leadFeature.featuredImage.asset, 1200)}
                alt={leadFeature.featuredImage.alt}
                loading="eager"
                decoding="async"
              />
            )}
            <div class="card-meta">
              {leadFeature.publishedAt && <time datetime={leadFeature.publishedAt}>{formatDate(leadFeature.publishedAt)}</time>}
            </div>
            <h2 class="lead-title">{leadFeature.title}</h2>
            <p class="lead-summary">{leadFeature.summary}</p>
            <span class="card-action">Read article <span aria-hidden="true">→</span></span>
          </a>
        </article>

        <!-- Secondary Features Stack -->
        <div class="secondary-stack">
          {secondaryFeatures.length > 0 ? (
            secondaryFeatures.map((item) => (
              <article class="secondary-card">
                <a class="secondary-link" href={contentHref(item._type, item.slug)} aria-label={`Read ${item.title}`}>
                  <h3 class="secondary-title">{item.title}</h3>
                  <p class="secondary-summary">{item.summary}</p>
                  <span class="card-action">Explore <span aria-hidden="true">→</span></span>
                </a>
              </article>
            ))
          ) : (
            <div class="secondary-card secondary-placeholder">
              <p class="eyebrow">Curated Technical Publication</p>
              <h3>Focused Engineering Knowledge</h3>
              <p>Articles, guided workshops, and system design archetypes exploring distributed systems, platform infrastructure, and AI engineering.</p>
            </div>
          )}
        </div>
      </div>
    ) : (
      <EmptyState
        title="Publication ready"
        message="Curated featured articles, system design archetypes, and workshops will appear here once published."
      />
    )}
  </section>

  <!-- 2. SYSTEM DESIGN & ARCHETYPES -->
  <section class="section shell system-design-section" aria-labelledby="system-design-heading">
    <div class="section-header">
      <div>
        <h2 id="system-design-heading">System Design</h2>
        <p class="section-subheading">The principles and practice of designing scalable, reliable, and distributed software systems.</p>
      </div>
    </div>

    <!-- Archetypes Spotlight Module -->
    <div class="archetypes-banner">
      <div class="archetypes-header">
        <h3>Architectural Archetypes &amp; Problem Classification</h3>
        <p class="archetypes-copy">
          A framework for classifying system-design problems, identifying correctness invariants, and composing architectural mechanisms to satisfy system requirements.
        </p>
      </div>
      <div class="archetypes-footer">
        <a class="button primary" href="/topics/system-design/">Explore the Framework →</a>
      </div>
    </div>

    {systemDesignCombined.length > 0 ? (
      <div class="card-grid system-design-grid">
        {systemDesignCombined.map((item) => (
          <ContentCard item={item} />
        ))}
      </div>
    ) : null}
  </section>

  <!-- 3. LATEST PUBLICATIONS -->
  <section class="section shell latest-section" aria-labelledby="latest-heading">
    <div class="section-header">
      <div>
        <h2 id="latest-heading">Latest Publications</h2>
        <p class="section-subheading">Chronological stream of technical deep dives, notes, and lab experiments.</p>
      </div>
      <a class="section-nav-link" href="/articles/">Browse all articles →</a>
    </div>

    {latest.length > 0 ? (
      <div class="card-grid">
        {latest.slice(0, 6).map((item) => (
          <ContentCard item={item} />
        ))}
      </div>
    ) : (
      <EmptyState
        title="The notebook is ready"
        message="Published articles, workshops, and case studies will appear in this chronological stream."
      />
    )}
  </section>

  <!-- 4. WORKSHOPS MODULE -->
  <section class="section shell workshops-section" aria-labelledby="workshops-heading">
    <div class="banner-card">
      <div class="banner-card-content">
        <h2 id="workshops-heading" class="banner-card-title">Engineering Workshops</h2>
        <p class="banner-card-desc">Practical investigations of software engineering concepts through implementation, experimentation, and analysis of system behavior.</p>
      </div>
      <div class="banner-card-action">
        <a class="banner-card-link" href="/workshops/">Explore Workshops <span aria-hidden="true">→</span></a>
      </div>
    </div>

    {workshops.length > 0 && (
      <div class="card-grid card-grid--spaced">
        {workshops.slice(0, 2).map((item) => (
          <ContentCard item={item} />
        ))}
      </div>
    )}
  </section>

  <!-- 5. OTHER DOMAINS: SOFTWARE ARCHITECTURE & PLATFORM ENGINEERING -->
  <section class="section shell disciplines-section" aria-labelledby="disciplines-heading">
    <div class="section-header">
      <div>
        <h2 id="disciplines-heading">Explore by Discipline</h2>
        <p class="section-subheading">Study notes, technical articles, and implementation guides organized by subject.</p>
      </div>
    </div>

    <div class="disciplines-grid">
      <article class="discipline-card">
        <div class="discipline-content">
          <h3>Software Engineering</h3>
          <p class="discipline-desc">Programming languages, frameworks, algorithms, data structures, and software design.</p>
        </div>
        <a class="discipline-link" href="/topics/software-architecture/">Explore Software Engineering <span aria-hidden="true">→</span></a>
      </article>

      <article class="discipline-card">
        <div class="discipline-content">
          <h3>Cloud & Platform Engineering</h3>
          <p class="discipline-desc">Cloud architecture, infrastructure, deployment systems, observability, and operational reliability.</p>
        </div>
        <a class="discipline-link" href="/topics/platform-engineering/">Explore Cloud & Platforms <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <!-- 6. PROJECTS ENTRY -->
  <section class="section shell projects-strip-section" aria-labelledby="projects-heading">
    <div class="banner-card">
      <div class="banner-card-content">
        <p id="projects-heading" class="banner-card-eyebrow">ENGINEERING PROJECTS &amp; CASE STUDIES</p>
        <p class="banner-card-desc">Documenting engineering work through the problems addressed, architectural decisions, implementation challenges, and outcomes.</p>
      </div>
      <div class="banner-card-action">
        <a class="banner-card-link" href="/projects/">Explore Projects <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>


<style>
  .section-subheading {
    margin: 4px 0 12px;
    color: var(--text-muted);
    font-size: var(--text-base);
  }
  .section-nav-link {
    color: var(--link);
    font-size: var(--text-nav);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }
  .section-nav-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  /* Featured */
  .featured-section {
    padding-top: 32px;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(320px, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .lead-feature-card,
  .secondary-card {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    transition: border-color 140ms ease;
  }
  .secondary-card {
    height: 100%;
  }
  .lead-feature-card:hover,
  .secondary-card:hover {
    border-color: var(--border-strong);
  }
  .lead-link {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 100%;
    padding: clamp(24px, 3vw, 32px);
    text-decoration: none;
  }
  .lead-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 360px;
    object-fit: contain;
    margin-bottom: 16px;
    border-radius: 2px;
  }
  .lead-link .card-action {
    margin-top: auto;
  }
  .lead-title {
    margin: 12px 0 8px;
    font-size: var(--text-xl);
  }
  .lead-summary {
    color: var(--text-muted);
    margin: 0 0 20px;
  }

  .secondary-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .secondary-link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 20px 24px;
    text-decoration: none;
  }
  .secondary-title {
    margin: 10px 0 6px;
    font-size: var(--text-lg);
  }
  .secondary-summary {
    color: var(--text-muted);
    font-size: var(--text-base);
    margin: 0 0 12px;
  }
  .secondary-placeholder {
    padding: 24px;
    background: var(--background-subtle);
  }
  .secondary-placeholder h3 {
    margin: 0 0 8px;
    font-size: var(--text-lg);
  }
  .secondary-placeholder p:not(.eyebrow) {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-base);
  }

  /* Archetypes */
  .archetypes-banner {
    background: var(--background);
    border: 1px solid var(--border);
    border-left: 3px solid var(--selected-indicator);
    border-radius: 4px;
    padding: 24px;
    margin-bottom: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .archetypes-banner h3 {
    margin: 0 0 6px;
    font-size: var(--text-xl);
  }
  .archetypes-copy {
    margin: 0;
    color: var(--text-muted);
    max-width: 70ch;
  }

  /* Banner cards (Workshops & Projects) */
  .banner-card {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: clamp(20px, 3vw, 24px);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 140ms ease;
  }
  .banner-card:hover {
    border-color: var(--border-strong);
  }
  .banner-card-title {
    margin: 0 0 6px;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-strong);
  }
  .banner-card-eyebrow {
    margin: 0 0 6px;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .banner-card-desc {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .banner-card-action {
    display: flex;
    justify-content: flex-end;
  }
  .banner-card-link {
    color: var(--link);
    font-size: var(--text-nav);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .banner-card-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  /* Disciplines */
  .disciplines-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .discipline-card {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    transition: border-color 140ms ease;
  }
  .discipline-card:hover {
    border-color: var(--border-strong);
  }
  .discipline-card h3 {
    margin: 0 0 6px;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-strong);
  }
  .discipline-desc {
    color: var(--text-muted);
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .discipline-link {
    color: var(--link);
    font-size: var(--text-nav);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .discipline-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }

  /* Projects strip section */
  .projects-strip-section {
    padding-top: 8px;
    padding-bottom: 32px;
  }

  @media (max-width: 900px) {
    .featured-grid,
    .disciplines-grid {
      grid-template-columns: 1fr;
    }
    .archetypes-banner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
