---
import type { Props as PortableTextProps } from '@portabletext/astro/types';
import type { CalloutBlock } from '../lib/sanity/types';

type Props = PortableTextProps<CalloutBlock>;
const { node } = Astro.props;
const items = node.items ?? [];
---

<div class={`article-callout ${node.tone ? `callout-${node.tone}` : ''}`}>
  {node.title && (
    <div class="callout-header">
      <span class="callout-title">{node.title}</span>
    </div>
  )}
  {items.length > 0 && (
    <ol class="callout-list">
      {items.map((item) => (
        <li class={`callout-item ${item.status === 'current' ? 'is-current' : ''}`}>
          {item.status === 'completed' && item.href ? (
            <a href={item.href} class="callout-item-link">{item.title}</a>
          ) : (
            <span class="callout-item-text">{item.title}</span>
          )}
          {item.status === 'upcoming' && <span class="status-pill status-upcoming">Upcoming</span>}
        </li>
      ))}
    </ol>
  )}
</div>

<style>
  .article-callout {
    margin: 1.5em 0;
    padding: 16px 20px;
    background: var(--background-subtle);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-strong);
    border-radius: 4px;
    font-size: var(--text-nav);
  }
  .callout-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-weight: 600;
  }
  .callout-title {
    color: var(--text-strong);
    font-size: var(--text-sm);
  }
  .callout-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .callout-item {
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.5;
    font-size: var(--text-sm);
  }
  .callout-item.is-current {
    font-weight: 600;
  }
  .callout-item.is-current .callout-item-text {
    color: var(--text-strong);
    font-weight: 600;
  }
  .callout-item-link {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .callout-item-link:hover {
    color: var(--link-hover);
    text-decoration-thickness: 2px;
  }
  .callout-item-text {
    color: var(--text);
  }
  .status-pill {
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .status-upcoming {
    background: var(--badge-neutral-bg);
    color: var(--badge-neutral-text);
    border: 1px solid var(--border);
  }
</style>
