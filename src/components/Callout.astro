---
import type { Props as PortableTextProps } from '@portabletext/astro/types';
import type { CalloutBlock } from '../lib/sanity/types';

type Props = PortableTextProps<CalloutBlock>;
const { node } = Astro.props;
const items = node.items ?? [];
const currentIndex = items.findIndex((item) => item.status === 'current');
const prevItem = currentIndex > 0 ? items[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 && currentIndex < items.length - 1 ? items[currentIndex + 1] : null;
---

<div class={`article-callout ${node.tone ? `callout-${node.tone}` : ''}`}>
  {node.title && (
    <div class="callout-header">
      <span class="callout-title">{node.title}</span>
    </div>
  )}
  {items.length > 0 && (
    <ol class="callout-list">
      {items.map((item) => (
        <li class={`callout-item ${item.status === 'current' ? 'is-current' : ''}`}>
          {item.status === 'completed' && item.href ? (
            <a href={item.href} class="callout-item-link">{item.title}</a>
          ) : (
            <span class="callout-item-text">{item.title}</span>
          )}
          {item.status === 'current' && <span class="status-pill status-current">Current</span>}
          {item.status === 'upcoming' && <span class="status-pill status-upcoming">Upcoming</span>}
        </li>
      ))}
    </ol>
  )}
  {(prevItem || nextItem) && (
    <div class="callout-nav">
      {prevItem && prevItem.href ? (
        <a href={prevItem.href} class="callout-nav-link callout-nav-prev">
          <span class="callout-nav-arrow" aria-hidden="true">←</span>
          <span class="callout-nav-meta">
            <span class="callout-nav-direction">Previous</span>
            <span class="callout-nav-title">{prevItem.title}</span>
          </span>
        </a>
      ) : (
        <div class="callout-nav-placeholder" />
      )}

      {nextItem ? (
        nextItem.status === 'completed' && nextItem.href ? (
          <a href={nextItem.href} class="callout-nav-link callout-nav-next">
            <span class="callout-nav-meta">
              <span class="callout-nav-direction">Next</span>
              <span class="callout-nav-title">{nextItem.title}</span>
            </span>
            <span class="callout-nav-arrow" aria-hidden="true">→</span>
          </a>
        ) : (
          <div class="callout-nav-upcoming callout-nav-next">
            <span class="callout-nav-meta">
              <span class="callout-nav-direction">Next (Upcoming)</span>
              <span class="callout-nav-title">{nextItem.title}</span>
            </span>
          </div>
        )
      ) : (
        <div class="callout-nav-placeholder" />
      )}
    </div>
  )}
</div>

<style>
  .article-callout {
    margin: 1.5em 0;
    padding: 16px 20px;
    background: var(--background-subtle);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-strong);
    border-radius: 4px;
    font-size: var(--text-nav);
  }
  .callout-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
    font-weight: 600;
  }
  .callout-title {
    color: var(--text-strong);
    font-size: var(--text-sm);
  }
  .callout-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .callout-item {
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.5;
    font-size: var(--text-sm);
  }
  .callout-item.is-current {
    font-weight: 600;
    color: var(--text-strong);
  }
  .callout-item-link {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .callout-item-link:hover {
    color: var(--link-hover);
    text-decoration-thickness: 2px;
  }
  .callout-item-text {
    color: var(--text);
  }
  .status-pill {
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .status-current {
    background: var(--badge-bg);
    color: var(--badge-text);
  }
  .status-upcoming {
    background: var(--badge-neutral-bg);
    color: var(--badge-neutral-text);
    border: 1px solid var(--border);
  }
  .callout-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .callout-nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .callout-nav-link:hover {
    border-color: var(--border-strong);
  }
  .callout-nav-prev {
    justify-content: flex-start;
    text-align: left;
  }
  .callout-nav-next {
    justify-content: flex-end;
    text-align: right;
  }
  .callout-nav-upcoming {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    background: var(--background);
    border: 1px dashed var(--border);
    border-radius: 4px;
    opacity: 0.7;
    cursor: default;
  }
  .callout-nav-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .callout-nav-direction {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }
  .callout-nav-title {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .callout-nav-arrow {
    color: var(--link);
    font-size: var(--text-sm);
    flex-shrink: 0;
  }
  .callout-nav-placeholder {
    visibility: hidden;
  }
  @media (max-width: 580px) {
    .callout-nav {
      grid-template-columns: 1fr;
    }
    .callout-nav-placeholder {
      display: none;
    }
    .callout-nav-next {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
