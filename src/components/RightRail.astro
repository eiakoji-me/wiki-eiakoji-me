---
import TableOfContents from './TableOfContents.astro';
import type { HeadingItem } from '../lib/slugify';
import type { Article } from '../lib/sanity/types';
import { topicHref, type TopicTree } from '../lib/topics';

interface Props {
  headings?: HeadingItem[];
  article?: Article;
  /** Topic links are rendered only for topics that have a hub page in this tree. */
  topicTree?: TopicTree;
}

const { headings = [], article, topicTree } = Astro.props;
const primaryTopicHref = topicTree ? topicHref(topicTree, article?.primaryTopic?.slug) : undefined;
const relatedTopicLinks = topicTree
  ? (article?.relatedTopics ?? []).flatMap((t) => {
      const href = topicHref(topicTree, t.slug);
      return href ? [{ title: t.title, href }] : [];
    })
  : [];
const isPublicRepo = Boolean(
  article?.repositoryUrl &&
  !article.repositoryUrl.includes('wiki-eiakoji-me') &&
  (article?.format === 'workshop' || article?.kind === 'workshop')
);
const hasActions = Boolean(isPublicRepo || article?.demoUrl);
---

<aside class="wiki-right-rail" aria-label="Article outline and context">
  {headings.length > 0 && <TableOfContents headings={headings} />}

  {hasActions && (
    <div class="rail-card actions-card">
      <div class="rail-header">Resources</div>
      <div class="action-buttons">
        {isPublicRepo && article?.repositoryUrl && (
          <a href={article.repositoryUrl} target="_blank" rel="noopener noreferrer" class="action-btn repo-btn">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span>GitHub Repository</span>
          </a>
        )}
        {article?.demoUrl && (
          <a href={article.demoUrl} target="_blank" rel="noopener noreferrer" class="action-btn demo-btn">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M4.75 3a.75.75 0 000 1.5h6.5a.75.75 0 000-1.5h-6.5zM3 6.75A.75.75 0 013.75 6h8.5a.75.75 0 010 1.5h-8.5A.75.75 0 013 6.75zM3.75 9a.75.75 0 000 1.5h4.5a.75.75 0 000-1.5h-4.5z"/>
            </svg>
            <span>Live Showcase</span>
          </a>
        )}
      </div>
    </div>
  )}

  {article?.primaryTopic && primaryTopicHref && (
    <div class="rail-card topic-card">
      <div class="rail-header">Topic Hub</div>
      <a href={primaryTopicHref} class="topic-link">
        <span>Explore {article.primaryTopic.title}</span>
        <span aria-hidden="true">→</span>
      </a>
      {relatedTopicLinks.length > 0 && (
        <div class="related-topics">
          <span class="related-label">Related:</span>
          {relatedTopicLinks.map((t) => (
            <a href={t.href} class="related-tag">{t.title}</a>
          ))}
        </div>
      )}
    </div>
  )}
</aside>

<style>
  .wiki-right-rail {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: var(--text-nav);
  }
  .rail-card {
    padding: 16px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .rail-header {
    margin-bottom: 10px;
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--text-muted);
  }
  .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    font-weight: 500;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: border-color 140ms ease;
  }
  .action-btn:hover {
    border-color: var(--border-strong);
    text-decoration: underline;
  }
  .topic-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    color: var(--link);
    text-decoration: none;
  }
  .topic-link:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
  .related-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px dashed var(--border);
  }
  .related-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .related-tag {
    font-size: var(--text-xs);
    padding: 2px 6px;
    background: var(--badge-neutral-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--badge-neutral-text);
    text-decoration: none;
  }
  .related-tag:hover {
    border-color: var(--border-strong);
    color: var(--text);
    text-decoration: underline;
  }
</style>
