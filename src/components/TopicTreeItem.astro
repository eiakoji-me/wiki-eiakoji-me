---
import type { TopicNode } from '../lib/topics';

interface Props {
  node: TopicNode;
  currentSlug?: string;
  depth?: number;
}

const { node, currentSlug, depth = 1 } = Astro.props;
const isCurrent = currentSlug === node.topic.slug;
---

<li class={`topic-node depth-${depth}`}>
  <a
    href={`/topics/${node.topic.slug}/`}
    class={`topic-link depth-${depth} ${isCurrent ? 'active' : ''}`}
  >
    <span class="topic-title">{node.topic.title}</span>
    {node.rollupArticleCount > 0 && (
      <span class="count-badge">{node.rollupArticleCount}</span>
    )}
  </a>
  {node.children.length > 0 && (
    <ul class={`subtopic-tree depth-${depth}`}>
      {node.children.map((child: TopicNode) => (
        <Astro.self node={child} currentSlug={currentSlug} depth={depth + 1} />
      ))}
    </ul>
  )}
</li>

<style>
  .topic-node {
    margin: 0;
  }
  .subtopic-tree {
    list-style: none;
    padding-left: 10px;
    margin: 2px 0 4px;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .topic-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    border-left: 2px solid transparent;
    border-radius: 0 4px 4px 0;
    color: var(--text-muted);
    font-size: var(--text-nav);
    text-decoration: none;
    line-height: 1.35;
    transition: background 120ms ease, color 120ms ease;
  }
  .topic-link.depth-1 {
    font-weight: 500;
    color: var(--text);
  }
  .topic-link.depth-3,
  .topic-link.depth-4 {
    font-size: var(--text-sm);
  }
  .topic-link:hover {
    background: var(--background-subtle);
    color: var(--text);
  }
  .topic-link:hover .topic-title {
    text-decoration: underline;
  }
  .topic-link.active {
    background: var(--selected-bg);
    color: var(--selected-text);
    border-left-color: var(--selected-indicator);
    font-weight: 600;
  }
  .topic-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .count-badge {
    margin-left: 6px;
    padding: 1px 6px;
    background: var(--badge-neutral-bg);
    border: 1px solid var(--border);
    color: var(--badge-neutral-text);
    font-size: var(--text-xs);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    border-radius: 10px;
  }
</style>
