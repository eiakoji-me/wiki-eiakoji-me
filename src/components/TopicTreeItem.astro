---
import type { NavTopicItem } from '../lib/topics';

interface Props {
  item: NavTopicItem;
  depth?: number;
}

const { item, depth = 1 } = Astro.props;
const linkClass = `topic-link depth-${depth}${item.current ? ' active' : ''}`;
---

<li class={`topic-node depth-${depth}`}>
  {item.href ? (
    <a href={item.href} class={linkClass} aria-current={item.current ? 'page' : undefined}>
      <span class="topic-title">{item.title}</span>
      {item.count > 0 && <span class="topic-count">{item.count}<span class="visually-hidden"> articles</span></span>}
    </a>
  ) : (
    <span class={linkClass}>
      <span class="topic-title">{item.title}</span>
      {item.count > 0 && <span class="topic-count">{item.count}<span class="visually-hidden"> articles</span></span>}
    </span>
  )}
  {item.children.length > 0 && (
    <ul class={`subtopic-tree depth-${depth}`}>
      {item.children.map((child: NavTopicItem) => (
        <Astro.self item={child} depth={depth + 1} />
      ))}
    </ul>
  )}
</li>

<style>
  .topic-node {
    margin: 0;
  }
  .subtopic-tree {
    list-style: none;
    padding-left: 10px;
    margin: 2px 0 4px;
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .topic-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 4px 8px;
    border-left: 2px solid transparent;
    border-radius: 0 4px 4px 0;
    color: var(--text-muted);
    font-size: var(--text-nav);
    text-decoration: none;
    line-height: 1.35;
    transition: background 120ms ease, color 120ms ease;
  }
  .topic-link.depth-1 {
    font-weight: 500;
    color: var(--text);
  }
  .topic-link.depth-3,
  .topic-link.depth-4 {
    font-size: var(--text-sm);
  }
  a.topic-link:hover {
    background: var(--background-subtle);
    color: var(--text);
  }
  a.topic-link:hover .topic-title {
    text-decoration: underline;
  }
  .topic-link.active {
    background: var(--selected-bg);
    color: var(--selected-text);
    border-left-color: var(--selected-indicator);
    font-weight: 600;
  }
  .topic-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .topic-count {
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 400;
  }
</style>
