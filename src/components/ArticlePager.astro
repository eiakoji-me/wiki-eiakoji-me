---
import type { CalloutBlock } from '../lib/sanity/types';

interface Props {
  body?: any[];
}

const { body = [] } = Astro.props;
const sequenceBlock = body?.find(
  (b: any) => b?._type === 'callout' && Array.isArray(b?.items) && b.items.length > 1
) as CalloutBlock | undefined;

const items = sequenceBlock?.items ?? [];
const currentIndex = items.findIndex((item) => item.status === 'current');
const prevItem = currentIndex > 0 ? items[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 && currentIndex < items.length - 1 ? items[currentIndex + 1] : null;

const hasNavigation = Boolean(prevItem || nextItem);
---

{hasNavigation && (
  <nav class="article-pager" aria-label="Article navigation">
    {prevItem && prevItem.href ? (
      <a href={prevItem.href} class="pager-link pager-prev">
        <span class="pager-arrow" aria-hidden="true">←</span>
        <div class="pager-content">
          <span class="pager-label">Prev</span>
          <span class="pager-title">{prevItem.title}</span>
        </div>
      </a>
    ) : (
      <div class="pager-spacer" />
    )}

    {nextItem && (
      nextItem.status === 'completed' && nextItem.href ? (
        <a href={nextItem.href} class="pager-link pager-next">
          <div class="pager-content">
            <span class="pager-label">Next</span>
            <span class="pager-title">{nextItem.title}</span>
          </div>
          <span class="pager-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <div class="pager-link pager-next is-upcoming">
          <div class="pager-content">
            <span class="pager-label">Next (Upcoming)</span>
            <span class="pager-title">{nextItem.title}</span>
          </div>
        </div>
      )
    )}
  </nav>
)}

<style>
  .article-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 56px;
    padding-block: 24px;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .pager-link {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }
  .pager-prev {
    justify-content: flex-start;
    text-align: left;
  }
  .pager-next {
    justify-content: flex-end;
    text-align: right;
  }
  .pager-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .pager-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .pager-title {
    font-size: var(--text-nav);
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-strong);
    transition: color 0.15s ease;
  }
  .pager-arrow {
    font-size: var(--text-base);
    color: var(--link);
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }
  .pager-link:hover .pager-title {
    color: var(--link);
    text-decoration: none;
  }
  .pager-prev:hover .pager-arrow {
    transform: translateX(-4px);
  }
  .pager-next:hover .pager-arrow {
    transform: translateX(4px);
  }
  .pager-link.is-upcoming {
    opacity: 0.55;
    cursor: default;
  }
  .pager-link.is-upcoming .pager-title {
    color: var(--text-muted);
    font-weight: 500;
  }
  .pager-link.is-upcoming:hover .pager-title {
    color: var(--text-muted);
    text-decoration: none;
  }
  .pager-spacer {
    visibility: hidden;
  }
  @media (max-width: 640px) {
    .article-pager {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .pager-spacer {
      display: none;
    }
    .pager-next {
      justify-content: space-between;
      text-align: left;
    }
    .pager-next .pager-arrow {
      order: 2;
    }
    .pager-next .pager-content {
      order: 1;
    }
  }
</style>
