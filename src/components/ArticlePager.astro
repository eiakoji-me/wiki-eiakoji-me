---
import type { CalloutBlock } from '../lib/sanity/types';

interface Props {
  body?: any[];
}

const { body = [] } = Astro.props;
const sequenceBlock = body?.find(
  (b: any) => b?._type === 'callout' && Array.isArray(b?.items) && b.items.length > 1
) as CalloutBlock | undefined;

const items = sequenceBlock?.items ?? [];
const currentIndex = items.findIndex((item) => item.status === 'current');
const prevItem = currentIndex > 0 ? items[currentIndex - 1] : null;
const nextItem = currentIndex >= 0 && currentIndex < items.length - 1 ? items[currentIndex + 1] : null;

const hasNavigation = Boolean(prevItem || nextItem);
---

{hasNavigation && (
  <nav class="article-pager" aria-label="Article navigation">
    {prevItem && prevItem.href ? (
      <a href={prevItem.href} class="pager-card pager-prev">
        <span class="pager-arrow" aria-hidden="true">←</span>
        <div class="pager-content">
          <span class="pager-direction">Previous Part</span>
          <span class="pager-title">{prevItem.title}</span>
        </div>
      </a>
    ) : (
      <div class="pager-placeholder" />
    )}

    {nextItem && (
      nextItem.status === 'completed' && nextItem.href ? (
        <a href={nextItem.href} class="pager-card pager-next">
          <div class="pager-content">
            <span class="pager-direction">Next Part</span>
            <span class="pager-title">{nextItem.title}</span>
          </div>
          <span class="pager-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <div class="pager-card pager-next is-upcoming">
          <div class="pager-content">
            <span class="pager-direction">Next Part (Upcoming)</span>
            <span class="pager-title">{nextItem.title}</span>
          </div>
        </div>
      )
    )}
  </nav>
)}

<style>
  .article-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .pager-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: var(--background-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .pager-card:hover {
    border-color: var(--border-strong);
    background: var(--background);
  }
  .pager-prev {
    justify-content: flex-start;
    text-align: left;
  }
  .pager-next {
    justify-content: flex-end;
    text-align: right;
  }
  .pager-prev:hover .pager-arrow {
    transform: translateX(-3px);
  }
  .pager-next:hover .pager-arrow {
    transform: translateX(3px);
  }
  .pager-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .pager-direction {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .pager-title {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pager-arrow {
    font-size: var(--text-base);
    color: var(--link);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }
  .pager-card.is-upcoming {
    opacity: 0.6;
    border-style: dashed;
    cursor: default;
  }
  .pager-placeholder {
    visibility: hidden;
  }
  @media (max-width: 640px) {
    .article-pager {
      grid-template-columns: 1fr;
    }
    .pager-placeholder {
      display: none;
    }
    .pager-next {
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
