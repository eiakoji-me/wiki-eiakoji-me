---
import { contentHref, formatDate } from '../lib/content';
import { imageUrl } from '../lib/sanity/image';
import type { ContentSummary } from '../lib/sanity/types';

interface Props {
  item: ContentSummary;
}

const { item } = Astro.props;
const href = contentHref(item._type, item.slug);
---

<article class="content-card">
  <a class="card-link" href={href} aria-label={`Read ${item.title}`}>
    <div class="card-body">
      <h2>{item.title}</h2>
      <p>{item.summary}</p>
      <div class="card-meta">
        {item.publishedAt && <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>}
      </div>
    </div>
    {item.featuredImage?.asset && (
      <img
        class="card-image"
        src={imageUrl(item.featuredImage.asset, 320)}
        alt={item.featuredImage.alt}
        loading="lazy"
        width="160"
        height="90"
      />
    )}
  </a>
</article>
