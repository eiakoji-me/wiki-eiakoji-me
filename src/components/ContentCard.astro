---
import { contentHref, formatDate, formatContentLabel } from '../lib/content';
import { imageUrl } from '../lib/sanity/image';
import type { ContentSummary } from '../lib/sanity/types';

interface Props {
  item: ContentSummary;
  articleCount?: number;
}

const { item, articleCount } = Astro.props;
const label = formatContentLabel(item.format || item.kind, item._type);
const href = contentHref(item._type, item.slug);
---

<article class="content-card">
  <a class="card-link" href={href} aria-label={`Read ${item.title}`}>
    <div class="card-body">
      <h2>{item.title}</h2>
      <p>{item.summary}</p>
      <div class="card-meta">
        {item.primaryTopic && <span class="card-domain">{item.primaryTopic.title}</span>}
        <span class="card-format">{label}</span>
        {item.publishedAt && <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>}
        {typeof articleCount === 'number' && <span>{articleCount} {articleCount === 1 ? 'article' : 'articles'}</span>}
      </div>
      {item.relatedTopics && item.relatedTopics.length > 0 && (
        <ul class="card-topics" aria-label="Topics">
          {item.relatedTopics.slice(0, 3).map((topic) => (
            <li>{topic.title}</li>
          ))}
        </ul>
      )}
    </div>
    {item.featuredImage?.asset && (
      <img
        class="card-image"
        src={imageUrl(item.featuredImage.asset, 320)}
        alt={item.featuredImage.alt}
        loading="lazy"
        width="160"
        height="90"
      />
    )}
  </a>
</article>
