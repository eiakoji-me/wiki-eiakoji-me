---
import { buildNavigation, type NavFeaturedItem, type NavTopicItem, type TopicTree } from '../lib/topics';
import type { ContentSummary } from '../lib/sanity/types';
import TopicTreeItem from './TopicTreeItem.astro';

interface Props {
  tree: TopicTree;
  articles?: ContentSummary[];
  currentSlug?: string;
  currentArticleSlug?: string;
}

const { tree, articles, currentSlug, currentArticleSlug } = Astro.props;

// The top nav already lists the domains; this nav complements it.
const nav = buildNavigation(tree, { articles, currentSlug, currentArticleSlug });
const topics = nav.topics;
---

{(nav.featured.length > 0 || topics) && (
  <aside class="wiki-left-nav" aria-label="Knowledge navigation">
    <details class="wiki-nav-disclosure" open>
      <summary class="wiki-nav-summary">
        <span>Featured & Topics</span>
        <span class="disclosure-arrow" aria-hidden="true">▾</span>
      </summary>

      <div class="wiki-nav-content">
        {nav.featured.length > 0 && (
          <div class="nav-section">
            <div class="nav-section-title">Featured</div>
            <ul class="featured-list">
              {nav.featured.map((item: NavFeaturedItem) => (
                <li>
                  <a
                    href={item.href}
                    class={`featured-link${item.current ? ' active' : ''}`}
                    aria-current={item.current ? 'page' : undefined}
                  >
                    {item.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {topics?.mode === 'domain' && (
          <div class="nav-section">
            <div class="nav-section-title nav-domain-label">{topics.domain.title}</div>
            <ul class="topic-tree">
              {topics.topics.map((item: NavTopicItem) => (
                <TopicTreeItem item={item} depth={1} />
              ))}
            </ul>
          </div>
        )}

        {topics?.mode === 'popular' && (
          <div class="nav-section">
            <div class="nav-section-title">Popular topics</div>
            <ul class="topic-tree">
              {topics.topics.map((item: NavTopicItem) => (
                <TopicTreeItem item={item} depth={1} />
              ))}
              <li class="topic-node">
                <a href={topics.allTopicsHref} class="all-topics-link">All topics →</a>
              </li>
            </ul>
          </div>
        )}
      </div>
    </details>
  </aside>
)}

<style>
  .wiki-left-nav {
    position: sticky;
    top: 96px;
    font-size: var(--text-nav);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: 12px;
  }
  /* The nav scrolls, so an outset focus ring would be clipped at its left edge. */
  .wiki-left-nav :global(a:focus-visible) {
    outline-offset: -2px;
  }
  .wiki-nav-disclosure {
    border: none;
    margin: 0;
    padding: 0;
  }
  .wiki-nav-summary {
    display: none;
    cursor: pointer;
    font-weight: 500;
    font-size: var(--text-nav);
    padding: 10px 14px;
    background: var(--background);
    border: 1px solid var(--control-border);
    border-radius: 4px;
    margin-bottom: 16px;
    list-style: none;
    justify-content: space-between;
    align-items: center;
  }
  .wiki-nav-summary::-webkit-details-marker {
    display: none;
  }
  .nav-section {
    margin-bottom: 24px;
  }
  .nav-section-title {
    margin-bottom: 8px;
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--text-muted);
  }
  .topic-tree, .featured-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .featured-link, .all-topics-link {
    display: block;
    padding: 4px 8px;
    color: var(--text);
    text-decoration: none;
    border-left: 2px solid transparent;
    border-radius: 0 4px 4px 0;
    line-height: 1.35;
    transition: background 120ms ease, color 120ms ease;
  }
  .all-topics-link {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .featured-link:hover, .all-topics-link:hover {
    background: var(--background-subtle);
    color: var(--text);
  }
  .featured-link.active {
    background: var(--selected-bg);
    color: var(--selected-text);
    border-left-color: var(--selected-indicator);
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .wiki-left-nav {
      position: static;
      max-height: none;
      margin-bottom: 24px;
    }
    .wiki-nav-summary {
      display: flex;
    }
    .wiki-nav-disclosure:not([open]) .wiki-nav-content {
      display: none;
    }
  }
</style>
