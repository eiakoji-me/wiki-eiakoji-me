---
import { buildNavigation, type TopicNode, type TopicTree } from '../lib/topics';
import TopicTreeItem from './TopicTreeItem.astro';

interface Props {
  tree: TopicTree;
  currentSlug?: string;
}

const { tree, currentSlug } = Astro.props;

const nav = buildNavigation(tree);
---

{nav.domains.length > 0 && (
  <aside class="wiki-left-nav" aria-label="Knowledge navigation">
    <details class="wiki-nav-disclosure" open>
      <summary class="wiki-nav-summary">
        <span>Navigation & Topics</span>
        <span class="disclosure-arrow" aria-hidden="true">▾</span>
      </summary>

      <div class="wiki-nav-content">
        <div class="nav-section">
          <div class="nav-section-title">Domains</div>
          <ul class="topic-tree">
            {nav.domains.map((domainNode: TopicNode) => (
              <TopicTreeItem node={domainNode} currentSlug={currentSlug} depth={1} />
            ))}
          </ul>
        </div>
      </div>
    </details>
  </aside>
)}

<style>
  .wiki-left-nav {
    position: sticky;
    top: 96px;
    font-size: var(--text-nav);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: 12px;
  }
  /* The nav scrolls, so an outset focus ring would be clipped at its left edge. */
  .wiki-left-nav :global(a:focus-visible) {
    outline-offset: -2px;
  }
  .wiki-nav-disclosure {
    border: none;
    margin: 0;
    padding: 0;
  }
  .wiki-nav-summary {
    display: none;
    cursor: pointer;
    font-weight: 500;
    font-size: var(--text-nav);
    padding: 10px 14px;
    background: var(--background);
    border: 1px solid var(--control-border);
    border-radius: 4px;
    margin-bottom: 16px;
    list-style: none;
    justify-content: space-between;
    align-items: center;
  }
  .wiki-nav-summary::-webkit-details-marker {
    display: none;
  }
  .nav-section {
    margin-bottom: 24px;
  }
  .nav-section-title {
    margin-bottom: 8px;
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--text-muted);
  }
  .topic-tree, .subtopic-tree, .nested-subtopic-tree {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .topic-node, .subtopic-node {
    margin-bottom: 2px;
  }
  .topic-link, .subtopic-link, .nested-subtopic-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 4px 10px;
    color: var(--text);
    text-decoration: none;
    border-left: 2px solid transparent;
    border-radius: 0 4px 4px 0;
    line-height: 1.35;
    transition: background 120ms ease, color 120ms ease;
  }
  .topic-link:hover, .subtopic-link:hover, .nested-subtopic-link:hover {
    background: var(--background-subtle);
    text-decoration: underline;
  }
  .topic-link.active, .subtopic-link.active, .nested-subtopic-link.active {
    background: var(--selected-bg);
    color: var(--selected-text);
    border-left-color: var(--selected-indicator);
    font-weight: 600;
  }
  .subtopic-tree {
    margin: 4px 0 6px 14px;
    border-left: 1px solid var(--border);
    padding-left: 6px;
  }
  .nested-subtopic-tree {
    margin: 4px 0 6px 12px;
    border-left: 1px dashed var(--border);
    padding-left: 6px;
  }
  .subtopic-link {
    font-size: var(--text-sm);
    color: var(--text-muted);
    padding: 4px 8px;
  }
  .nested-subtopic-link {
    font-size: var(--text-xs);
    color: var(--text-muted);
    padding: 3px 6px;
  }
  .count-badge {
    font-size: var(--text-xs);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    padding: 1px 6px;
    background: var(--badge-neutral-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--badge-neutral-text);
  }

  @media (max-width: 960px) {
    .wiki-left-nav {
      position: static;
      max-height: none;
      margin-bottom: 24px;
    }
    .wiki-nav-summary {
      display: flex;
    }
    .wiki-nav-disclosure:not([open]) .wiki-nav-content {
      display: none;
    }
  }
</style>
